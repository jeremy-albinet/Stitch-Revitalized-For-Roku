    // Fail on high severity and above. Each allowlisted entry notes why it is safe to defer.
    "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
    "high": true,
    "allowlist": [
        {
            "GHSA-vfj7-8cjw-p6xm": {
                // Added: 2026-10-18
                "active": true,
                "notes": "`braces` <=3.0.3 (dev only, via `brighterscript` > `chokidar`/`micromatch`): stack exhaustion on deeply nested brace patterns. No patched version is published, so it cannot be upgraded or overridden. The only patterns reaching it are globs from our own bsconfig and npm scripts, and it never ships in the Roku package. Upstream RokuCommunity allowlists the same advisory."
            }
        }
    ]
}
