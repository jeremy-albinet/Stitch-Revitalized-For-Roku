<component name="ExitWorkerBoundary" extends="Group">
  <interface>
    <field id="sessionId" type="string" />
    <field id="inputDescriptor" type="assocarray" />
    <field id="experimentalMode" type="boolean" />
    <field id="cacheBudgetBytes" type="integer" />
    <field id="listenPort" type="integer" />
    <field id="functionName" type="string" />
    <field id="control" type="string" onChange="onControl" />
    <field id="state" type="string" alwaysNotify="true" />
    <field id="ready" type="assocarray" alwaysNotify="true" />
    <field id="result" type="assocarray" alwaysNotify="true" />
    <field id="stopRequested" type="boolean" />
  </interface>
  <script uri="ExitWorkerBoundary.brs" />
</component>
