<!-- Task transport boundary; production createApiTask/destroyTask and native observers run. -->
<component name="TwitchApiTask" extends="Group">
    <interface>
        <field id="response" type="assocarray" alwaysNotify="true" />
        <field id="request" type="assocarray" />
        <field id="followStopRequested" type="boolean" value="false" />
        <field id="control" type="string" value="stop" />
        <field id="functionName" type="string" />
    </interface>
</component>
