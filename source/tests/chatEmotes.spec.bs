import "pkg:/components/Modules/EmojiLabel/EmojiLabelRegex.brs"
import "pkg:/components/Modules/EmojiLabel/EmojiLabelUtil.brs"

namespace tests
    @suite("Chat emoji images")
    class ChatEmotesTests extends rooibos.BaseTestSuite
        @describe("Tokenizer and provider assets")
        @it("tokenizes adjacent and repeated emoji using the actual native PCRE pattern")
        sub adjacentEmoji()
            runs = emojiTextRuns("hello" + chr(&h1F600) + chr(&h1F600) + "world")
            m.assertEqual(runs.count(), 4)
            if runs.count() <> 4 then return
            m.assertEqual(runs[0].text, "hello")
            m.assertEqual(runs[1].uri, toURI("1f600"))
            m.assertEqual(runs[2].uri, toURI("1f600"))
            m.assertEqual(runs[3].text, "world")
        end sub

        @it("keeps skin tones, family ZWJ, flags and keycaps in single image runs")
        sub sequences()
            samples = [
                { text: chr(&h1F44D) + chr(&h1F3FD), point: "1f44d-1f3fd" },
                { text: chr(&h1F468) + chr(&h200D) + chr(&h1F469) + chr(&h200D) + chr(&h1F467) + chr(&h200D) + chr(&h1F466), point: "1f468-200d-1f469-200d-1f467-200d-1f466" },
                { text: chr(&h1F1FA) + chr(&h1F1F8), point: "1f1fa-1f1f8" },
                { text: "1" + chr(&hFE0F) + chr(&h20E3), point: "31-20e3" },
                { text: chr(&h1FAE8), point: "1fae8" },
                { text: chr(&h1FA77), point: "1fa77" }
            ]
            for each sample in samples
                runs = emojiTextRuns(sample.text)
                m.assertEqual(runs.count(), 1)
                if runs.count() = 1 then m.assertEqual(runs[0].uri, toURI(sample.point))
            end for
        end sub

        @it("normalizes VS16 outside ZWJ sequences against pinned assets")
        sub variationSelectors()
            m.assertEqual(emojiPointName(chr(&h2764) + chr(&hFE0F)), "https://cdn.jsdelivr.net/gh/jdecked/twemoji@17.0.3/assets/72x72/2764.png")
            rainbow = chr(&h1F3F3) + chr(&hFE0F) + chr(&h200D) + chr(&h1F308)
            m.assertEqual(emojiPointName(rainbow), toURI("1f3f3-fe0f-200d-1f308"))
            runs = emojiTextRuns(rainbow)
            m.assertEqual(runs.count(), 1)
            if runs.count() = 1 then m.assertEqual(runs[0].uri, toURI("1f3f3-fe0f-200d-1f308"))
        end sub

        @it("leaves ASCII, accents and other non-emoji scripts as text")
        sub ordinaryText()
            text = "hello 123 #* caf" + chr(&hE9) + " " + chr(&h4F60) + chr(&h597D)
            runs = emojiTextRuns(text)
            m.assertEqual(runs.count(), 1)
            if runs.count() <> 1 then return
            m.assertEqual(runs[0].text, text)
            m.assertEqual(runs[0].uri, "")
            m.assertEqual(emojiFallback(chr(&h1F621)), "[emoji]")
        end sub

        @it("preserves Twitch code-point offsets after Unicode")
        sub twitchOffsets()
            m.assertEqual(ircEmoteText(chr(&h1F600) + " Kappa", 2, 5), "Kappa")
            m.assertEqual(ircEmoteText("abc", 2, 5), "")
        end sub

        @it("uses advertised 7TV static WebP while preferring PNG and refusing AVIF")
        sub providerImages()
            host = { url: "//cdn.7tv.app/emote/id", files: [{ name: "2x.webp", static_name: "2x_static.webp" }, { name: "1x.webp", static_name: "1x_static.webp" }] }
            m.assertEqual(irc7tvImage({ data: { animated: true, host: host } }), "https://cdn.7tv.app/emote/id/1x_static.webp")
            host.files.push({ name: "2x.png" })
            m.assertEqual(irc7tvImage({ data: { animated: true, host: host } }), "https://cdn.7tv.app/emote/id/2x.png")
            host.files = [{ name: "1x.avif", static_name: "1x_static.avif" }]
            m.assertInvalid(irc7tvImage({ data: { animated: true, host: host } }))
        end sub
    end class
end namespace
