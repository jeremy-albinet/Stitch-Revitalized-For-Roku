function validateOauthToken() as object
    access_token = get_user_setting("access_token", "")
    if access_token = ""
        m.top.response = { tokenValid: false, validationState: "anonymous" }
        m.top.control = TaskControl.STOP
        return invalid
    end if
    reqHeaders = {
        "Accept": "application/json",
        "Authorization": "OAuth " + access_token
    }
    req = HttpRequest({
        url: "https://id.twitch.tv/oauth2/validate",
        headers: reqHeaders,
        method: "GET",
        timeout: 10000
    })
    sendResult = req.send()
    status = 0
    if sendResult <> invalid then status = sendResult.getResponseCode()
    rsp = decodeJsonResponse(sendResult, true)
    state = getOAuthValidationState(status, rsp)
    m.top.response = { tokenValid: state = "valid", validationState: state }
    m.top.control = TaskControl.STOP
    return invalid
end function

sub getRendezvouzToken()
    req = HttpRequest({
        url: "https://id.twitch.tv/oauth2/device?scopes=channel_read%20chat%3Aread%20user_blocks_edit%20user_blocks_read%20user_follows_edit%20user_read&client_id=ue6666qo983tsx6so1t0vnawi233wa",
        headers: {
            "content-type": "application/x-www-form-urlencoded",
            "origin": "https://android.tv.twitch.tv",
            "referer": "https://android.tv.twitch.tv/"
        },
        method: "POST"
    })
    rsp = decodeJsonResponse(req.send())
    if rsp = invalid or rsp?.device_code = invalid or rsp?.user_code = invalid
        m.top.response = invalid
        m.top.control = TaskControl.STOP
        return
    end if
    m.top.response = {
        device_code: rsp.device_code,
        user_code: rsp.user_code,
        interval: boundedHttpOption(rsp?.interval, 5, 1, 60),
        expires_in: boundedHttpOption(rsp?.expires_in, 1800, 1, 3600),
        verification_uri: rsp?.verification_uri ?? "https://twitch.tv/activate"
    }
    m.top.control = TaskControl.STOP
end sub


function getOauthToken()
    params = m.top.request?.params
    if params?.device_code = invalid
        m.top.response = invalid
        m.top.control = TaskControl.STOP
        return invalid
    end if
    encoder = CreateObject("roUrlTransfer")
    if encoder = invalid
        m.top.response = invalid
        m.top.control = TaskControl.STOP
        return invalid
    end if
    requestData = "client_id=ue6666qo983tsx6so1t0vnawi233wa&device_code=" + encoder.Escape(params.device_code) + "&grant_type=urn%3Aietf%3Aparams%3Aoauth%3Agrant-type%3Adevice_code"
    interval = boundedHttpOption(params?.interval, 5, 1, 60)
    lifetime = boundedHttpOption(params?.expires_in, 1800, 1, 3600)
    deadline = CreateObject("roTimeSpan")
    deadline.Mark()
    rsp = invalid
    while deadline.TotalSeconds() < lifetime
        remainingMs = Int((lifetime - deadline.TotalSeconds()) * 1000)
        if remainingMs < 50 then exit while
        req = HttpRequest({
            url: "https://id.twitch.tv/oauth2/token",
            headers: {
                "content-type": "application/x-www-form-urlencoded",
                "origin": "https://android.tv.twitch.tv",
                "referer": "https://android.tv.twitch.tv/",
                "accept": "application/json"
            },
            method: "POST",
            data: requestData,
            timeout: boundedHttpOption(remainingMs, 10000, 50, 10000)
        })
        event = req.send()
        status = 0
        if event <> invalid then status = event.getResponseCode()
        rsp = decodeJsonResponse(event, true)
        state = getOAuthPollState(status, rsp)
        if state = "success" then exit while
        if state = "denied" or state = "expired" or state = "error"
            rsp = invalid
            exit while
        end if
        if state = "slow_down" or state = "network" then interval = boundedHttpOption(interval + 5, 5, 1, 60)
        remainingMs = Int((lifetime - deadline.TotalSeconds()) * 1000)
        if remainingMs <= 0 then exit while
        pauseMs = Int(interval * 1000)
        if pauseMs > remainingMs then pauseMs = remainingMs
        sleep(pauseMs)
    end while
    if rsp <> invalid and rsp?.access_token <> invalid
        m.top.response = {
            access_token: rsp.access_token,
            refresh_token: rsp?.refresh_token,
            expires_in: rsp?.expires_in
        }
    else
        m.top.response = invalid
    end if
    m.top.control = TaskControl.STOP
    return invalid
end function
