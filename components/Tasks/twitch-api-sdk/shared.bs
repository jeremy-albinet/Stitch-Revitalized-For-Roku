function GetRandomUUID()
    di = CreateObject("roDeviceInfo")
    return di.GetRandomUUID()
end function

function getDeviceLocale()
    di = CreateObject("roDeviceInfo")
    return di.GetCurrentLocale().Replace("_", "-")
end function

function TwitchGraphQLRequest(data)
    access_token = invalid
    device_code = invalid
    device_code = get_user_setting("device_code")
    if device_code = invalid then return invalid
    ' Account changes can invalidate a second registry read.
    token = get_user_setting("access_token")
    if token <> invalid then access_token = "OAuth " + token
    reqHeaders = {
        "Accept": "*/*",
        "Client-Id": "ue6666qo983tsx6so1t0vnawi233wa",
        "Device-ID": device_code,
        "Origin": "https://android.tv.twitch.tv",
        "Referer": "https://android.tv.twitch.tv/",
        "Accept-Language": getDeviceLocale()
    }
    if access_token <> invalid
        reqHeaders["Authorization"] = access_token
    end if
    req = HttpRequest({
        url: "https://gql.twitch.tv/gql",
        headers: reqHeaders,
        method: "POST",
        data: data
    })
    rspData = req.send()
    rsp = decodeJsonResponse(rspData)
    if rsp = invalid
        trackEvent("api_error", { api: "graphql", reason: "network_failure" })
        return invalid
    end if
    return rsp
end function

' GraphQL can return errors alongside usable partial data. A field failed when
' the response has no data object, omits a field on the path, or nulls one with
' an error at or beneath it. A field nulled without an error is a valid empty
' result, such as an unknown channel.
function graphQLFieldFailed(rsp as dynamic, path as object) as boolean
    if type(rsp) <> "roAssociativeArray" then return true
    value = rsp.data
    walked = []
    for each key in path
        if type(value) <> "roAssociativeArray" then return true
        if not value.doesExist(key) then return true
        value = value[key]
        walked.push(key)
        if value = invalid then return graphQLErrorAt(rsp.errors, walked)
    end for
    return false
end function

' An error without a path cannot be attributed, so it counts against every field.
function graphQLErrorAt(errors as dynamic, fieldPath as object) as boolean
    if type(errors) <> "roArray" then return false
    for each graphQLError in errors
        errorPath = invalid
        if type(graphQLError) = "roAssociativeArray" then errorPath = graphQLError.path
        if type(errorPath) <> "roArray" or errorPath.count() = 0 then return true
        if errorPath.count() >= fieldPath.count()
            matches = true
            for i = 0 to fieldPath.count() - 1
                segment = errorPath[i]
                if GetInterface(segment, "ifString") = invalid or LCase(segment) <> LCase(fieldPath[i])
                    matches = false
                    exit for
                end if
            end for
            if matches then return true
        end if
    end for
    return false
end function

sub TwitchHelixApiRequest()
    ? "HelixAPIRequest"
    access_token = ""
    device_code = ""
    ' doubled up here in stead of defaulting to "" because access_token is dependent on device_code
    if get_user_setting("device_code") <> invalid
        device_code = get_user_setting("device_code")
        if get_user_setting("access_token") <> invalid
            access_token = "Bearer " + get_user_setting("access_token")
        end if
    end if
    requestParams = {
        url: "https://api.twitch.tv/helix/" + m.top.request.params.endpoint + "?" + m.top.request.params.args,
        headers: {
            "Accept": "*/*",
            "Authorization": access_token,
            "Client-Id": "ue6666qo983tsx6so1t0vnawi233wa",
            "Device-ID": device_code,
            "Origin": "https://android.tv.twitch.tv",
            "Referer": "https://android.tv.twitch.tv/"
        },
        method: m.top.request.params.method
    }
    if m.top.request.params.data <> invalid
        requestParams["data"] = m.top.request.params.data
    end if
    req = HttpRequest(requestParams)
    rsp = decodeJsonResponse(req.send())
    if rsp <> invalid
        m.top.response = rsp
    else
        m.top.response = { "response": invalid }
    end if
    m.top.control = TaskControl.STOP
end sub
