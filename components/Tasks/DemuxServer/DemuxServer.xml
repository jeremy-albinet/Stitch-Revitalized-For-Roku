<?xml version="1.0" encoding="utf-8"?>
<!-- On-device Enhanced Broadcasting demuxer (fmp4-demux-proxy port), plus the live-list ad-break fix. -->
<component name="DemuxServer" extends="Task">
    <interface>
        <field id="port" type="integer" value="5757" />
        <field id="ready" type="boolean" value="false" />
    </interface>
    <script type="text/brightscript" uri="DemuxServer.brs" />
    <script type="text/brightscript" uri="DemuxHls.brs" />
    <script type="text/brightscript" uri="DemuxMp4.brs" />
</component>
