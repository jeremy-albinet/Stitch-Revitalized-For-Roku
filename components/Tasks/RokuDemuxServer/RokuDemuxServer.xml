<?xml version="1.0" encoding="utf-8" ?>
<component name="RokuDemuxServer" extends="Task">
    <interface>
        <field id="sessionId" type="string" />
        <field id="inputDescriptor" type="assocarray" />
        <field id="experimentalMode" type="boolean" value="false" />
        <!-- Source-boundary staging is an independent, default-off capability. -->
        <field id="enableSourceTransitions" type="boolean" value="false" />
        <field id="enableAdMetadata" type="boolean" value="false" />
        <!-- Live only: a shorter window starts the player nearer the edge. -->
        <field id="lowLatency" type="boolean" value="false" />
        <field id="cacheBudgetBytes" type="integer" value="16777216" />
        <field id="listenPort" type="integer" value="0" />
        <field id="stopRequested" type="boolean" value="false" />
        <field id="ready" type="assocarray" alwaysNotify="true" />
        <field id="result" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/source/utils/rokuDemuxCommon.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/deviceCapabilities.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/playbackHls.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/rokuDemuxDescriptor.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/rokuDemuxBulk.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/rokuDemuxInitMetadata.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/rokuDemuxInitGate.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/rokuDemuxCore.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/rokuDemuxFetch.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/rokuDemuxProtocol.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/twitchAdCountdown.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/twitchAdClock.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/twitchAdProtocol.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/rokuDemuxServerPolicy.brs" />
    <script type="text/brightscript" uri="RokuDemuxServer.brs" />
</component>
