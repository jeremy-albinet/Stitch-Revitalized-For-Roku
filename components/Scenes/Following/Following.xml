        <field id="menuRequest" type="string" alwaysNotify="true" />
        <field id="followRefreshPending" type="boolean" value="false" />
    </interface>
    <script type="text/brightscript" uri="Following.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/misc.brs" />
