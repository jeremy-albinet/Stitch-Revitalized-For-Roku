<component name="Settings" extends="SceneManagerGroup" initialFocus="categoryList">
    <interface>
        <field id="finished" type="bool" />
    </interface>
    <children>
        <Group translation="[10, 96]">
            <Rectangle width="1920" height="1080" color="0x0e0e10FF" />
            <!-- Sidebar for categories -->
            <LabelList
                id="categoryList"
                translation="[40, 0]"
                itemSize="[200, 50]"
                focusBitmapUri="pkg:/images/focusindicator.9.png" focusFootprintBitmapUri="null"
                vertFocusAnimationStyle="floatingFocus"
                itemSpacing="[0,5]"
                focusedColor="0x9147FFFF"
                />
            <!-- Main settings list for selected category, now closer to the left and with less spacing -->
            <LabelList
                id="settingsMenu"
                translation="[100, 20]"
                itemSize="[720, 50]"
                numRows="10"
               
                focusBitmapUri="pkg:/images/focusindicator.9.png" focusFootprintBitmapUri="pkg:/images/focusfootprint_dim.9.png"
                vertFocusAnimationStyle="floatingFocus"
                itemSpacing="[0,5]"
                focusedColor="0x9147FFFF"
                />
            <!-- Modern card for setting details, moved left for balance -->
            <Rectangle
                id="detailsCard"
                translation="[900, 20]"
                width="914"
                height="780"
                color="0x18181bFF"
                opacity="0.95"
                />
            <LayoutGroup
                translation="[930, 40]"
                id="settingDetail"
                vertAlignment="top"
                horizAlignment="left"
                itemSpacings="[20]"
                >
                <ScrollingLabel font="font:LargeSystemFont" id="settingTitle" maxWidth="854" />
                <Label id="settingDesc" width="854" wrap="true" color="0xC8C8D0FF" />
                <RadioButtonList id="boolSetting" checkedIconUri="pkg:/images/checkmark.png" focusedCheckedIconUri="pkg:/images/checkmark.png" itemSize="[854, 72]" focusBitmapUri="pkg:/images/focusindicator.9.png" focusFootprintBitmapUri="null" focusedColor="0xFFFFFFFF" vertFocusAnimationStyle="floatingFocus">
                    <ContentNode role="content">
                        <ContentNode title="Disabled" />
                        <ContentNode title="Enabled" />
                    </ContentNode>
                </RadioButtonList>
            </LayoutGroup>
            <Poster
                id="supportQrPoster"
                translation="[930, 230]"
                uri="pkg:/images/qr_buymeacoffee.png"
                width="240"
                height="240"
                visible="false"
                />
            <RadioButtonList id="radioSetting" checkedIconUri="pkg:/images/checkmark.png" focusedCheckedIconUri="pkg:/images/checkmark.png" translation="[940, 230]" itemSize="[854, 72]" visible="false"
                inheritParentTransform="false" focusBitmapUri="pkg:/images/focusindicator.9.png" focusFootprintBitmapUri="null" focusedColor="0xFFFFFFFF" vertFocusAnimationStyle="floatingFocus" />

        </Group>
    </children>
    <script type="text/brightscript" uri="settings.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/config.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/misc.brs" />
</component>
