<?xml version="1.0" encoding="utf-8"?>
<component name="ChannelPage" extends="SceneManagerGroup">
    <interface>
        <function name="onDestroy" />
        <field id="contentRequested" type="node" onChange="updatePage" />
        <field id="backgroundColor" type="string" alias="background.color, background2.color" />
        <field id="selectedItem" type="node" />
    </interface>
    <script type="text/brightscript" uri="ChannelPage.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/misc.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/contentBuilder.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/config.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/recentlyWatched.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/taskFactory.brs" />
    <script type="text/brightscript" uri="pkg:/components/Modules/StatusPanel/StatusPanelHost.brs" />
    <children>
        <rectangle id="background" width="1280" height="720" />
        <Group id="banner" translation="[0, 0]"></Group>
        <rectangle id="background2" width="1280" height="720" translation="[0, 200]" />
        <Group id="container" translation="[ 110, 10 ]">
            <!-- Twitch channel header: the avatar overlaps the banner's lower
                 edge; a red ring and LIVE pill mark a live channel. -->
            <Group id="profile" translation="[0,128]">
                <Poster
                    id="liveRing"
                    uri="pkg:/images/twitch-redesign/circle-ring.png"
                    blendColor="0xEB0400FF"
                    width="132"
                    height="132"
                    translation="[-6,-6]"
                    visible="false" />
                <CirclePoster id="avatar" width="120" height="120" />
                <Group id="livePill" translation="[36,110]" visible="false">
                    <Poster id="livePillPlate" uri="pkg:/images/twitch-redesign/round4.9.png" blendColor="0xEB0400FF" width="48" height="24" />
                    <Label id="livePillLabel" color="0xFFFFFFFF" width="48" height="24" horizAlign="center" vertAlign="center">
                        <Font role="font" uri="pkg:/fonts/Archivo-Bold.otf" size="16" />
                    </Label>
                </Group>
                <SimpleLabel
                    id="username"
                    fontSize="32"
                    fontUri="pkg:/fonts/Archivo-Bold.otf"
                    color="0xEFEFF1FF"
                    translation="[144,78]" />
                <SimpleLabel
                    id="followers"
                    fontSize="20"
                    fontUri="pkg:/fonts/Archivo-Regular.otf"
                    color="0xADADB8FF"
                    translation="[144,122]" />
            </Group>
            <Group id="about" translation="[450,25]">
                <InfoPane
                    visible="false"
                    id="description"
                    width="600"
                    translation="[20,0]" />
            </Group>
            <RowList
                id="homeRowList"
                rowLabelOffset="[[0,5]]"
                rowLabelColor="0xEFEFF1FF"
                translation="[ 0,300 ]"
                itemComponentName="VideoItem"
                numRows="4"
                rowItemSize="[[320,180]]"
                rowItemSpacing="[[30,0]]"
                itemSize="[1980, 295]"
                itemSpacing="[ 0, 40 ]"
                showRowLabel="[ true ]"
                focusBitmapUri="pkg:/images/transparent.9.png"
                vertFocusAnimationStyle="fixedFocus"
                rowFocusAnimationStyle="fixedFocus">
                <Font role="rowLabelFont" uri="pkg:/fonts/Archivo-Bold.otf" size="24" />
            </RowList>
            <Label id="pinHint" color="0xADADB8FF" width="470" height="48" wrap="true" translation="[600,250]">
                <Font role="font" uri="pkg:/fonts/Archivo-Regular.otf" size="18" />
            </Label>
        </Group>
        <StatusPanel id="status" translation="[110, 330]" />
    </children>

</component>
