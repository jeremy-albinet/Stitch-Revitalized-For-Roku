<?xml version="1.0" encoding="utf-8"?>
<component name="MenuBar" extends="Group" initialFocus="MenuOptions">
  <children>
    <Rectangle
      visible="true"
      id="headerRect"
      color="0x26262cFF"
      width="1280"
      height="64"
      translation="[0, 0]"
    />

    <ButtonGroupHoriz id="MenuOptions" layoutDirection="horiz" horizAlignment="left" />
    <ButtonGroupHoriz id="IconOptions" layoutDirection="horiz" horizAlignment="left" />
  </children>
  <interface>
    <field id="buttonFocused" type="int" value="-1" alwaysNotify="true" />
    <field id="buttonSelected" type="int" value="-1" alwaysNotify="true" />
    <field
      id="menuOptionsText"
      type="stringarray"
      value="[]"
      onChange="updateMenuOptions"
    />
    <field id="menuTextColor" type="color" value="0xEFEFF1FF" />
    <field id="menuFocusColor" type="color" value="0x9146FFCC" />
    <field id="menuOptionsSpacing" type="int" value="0" />
    <field
      id="menuOptionsTranslation"
      type="vector2d"
      value="[15,0]"
      alias="MenuOptions.translation"
    />
    <field id="menuFontSize" type="int" value="22" />
    <field id="menuFontUri" type="uri" value="pkg:/fonts/Archivo-Bold.otf" />
    <field id="showSearchIcon" type="bool" value="true" onChange="updateMenuOptions" />
    <field id="showSettingsIcon" type="bool" value="true" onChange="updateMenuOptions" />
    <field id="showLoginIcon" type="bool" value="true" onChange="updateMenuOptions" />
    <field id="updateUserIcon" type="bool" value="false" />
  </interface>
  <script type="text/brightscript" uri="MenuBar.brs" />
  <script type="text/brightscript" uri="pkg:/source/utils/misc.brs" />
  <script type="text/brightscript" uri="pkg:/source/utils/config.brs" />
  <script type="text/brightscript" uri="pkg:/source/utils/taskFactory.brs" />
</component>
