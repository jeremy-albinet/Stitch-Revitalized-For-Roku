<?xml version="1.0" encoding="utf-8"?>
<!-- Shared loading/empty/error panel. Hosts own requests and retries; the
     panel presents state and reports the selected action index. -->
<component name="StatusPanel" extends="Group">
    <interface>
        <function name="onDestroy" />
        <field id="supportsDisposal" type="boolean" value="true" />
        <!-- hidden | loading | empty | error -->
        <field id="state" type="string" value="hidden" onChange="onStateChange" />
        <field id="title" type="string" onChange="onContentChange" />
        <field id="message" type="string" onChange="onContentChange" />
        <!-- Button labels, already localized -->
        <field id="actions" type="array" onChange="onContentChange" />
        <field id="actionSelected" type="integer" value="-1" alwaysNotify="true" />
        <field id="panelWidth" type="integer" value="720" onChange="onContentChange" />
        <!-- True while action buttons are shown and can take focus -->
        <field id="hasActions" type="boolean" value="false" />
    </interface>
    <script type="text/brightscript" uri="StatusPanel.brs" />
    <children>
        <!-- Delays the spinner so fast loads do not flash it. -->
        <Timer id="spinnerDelay" duration="0.6" repeat="false" />
        <Poster id="plate" uri="pkg:/images/twitch-redesign/round6.9.png" blendColor="0x1F1F23FF" width="720" height="100" />
        <!-- Coral rule down the left edge marks an error -->
        <Rectangle id="accent" color="0xFF8280FF" width="4" height="100" visible="false" />
        <BusySpinner
            id="spinner"
            uri="pkg:/images/spinner.png"
            spinInterval="1"
            visible="false"
            translation="[32, 30]" />
        <Label
            id="title"
            wrap="true"
            maxLines="2"
            color="0xEFEFF1FF"
            translation="[32, 32]">
            <Font role="font" uri="pkg:/fonts/Archivo-Bold.otf" size="28" />
        </Label>
        <Label
            id="message"
            wrap="true"
            maxLines="4"
            lineSpacing="6"
            color="0xADADB8FF">
            <Font role="font" uri="pkg:/fonts/Archivo-Regular.otf" size="20" />
        </Label>
        <ButtonGroup
            id="buttons"
            visible="false"
            minWidth="280"
            maxWidth="280"
            buttonHeight="48"
            itemSpacings="[12]"
            iconUri=""
            focusedIconUri=""
            textColor="0xEFEFF1FF"
            focusedTextColor="0xFFFFFFFF"
            focusBitmapUri="pkg:/images/twitch-redesign/focus-round6.9.png"
            focusFootprintBitmapUri="pkg:/images/transparent.9.png">
            <Font role="textFont" uri="pkg:/fonts/Archivo-Bold.otf" size="20" />
            <Font role="focusedTextFont" uri="pkg:/fonts/Archivo-Bold.otf" size="20" />
        </ButtonGroup>
    </children>
</component>
