<?xml version="1.0" encoding="utf-8"?>

<component name="StitchVideo" extends="Video">

    <interface>
        <field id="supportsDisposal" type="boolean" value="true" />
        <function name="onDestroy" />
        <function name="setChannelActionsOpen" />
        <function name="showMessage" />
        <function name="hideMessage" />
        <function name="beginAdCountdown" />
        <function name="setAdMetadata" />
        <function name="clearAdCountdown" />
        <field id="thumbnailInfo" type="assocarray" />
        <field id="videoBookmarks" type="assocarray" />
        <field id="back" type="bool" value="false" />
        <field id="toggleChat" type="bool" value="false" />
        <field id="channelAvailable" type="boolean" value="false" onChange="onChannelAvailableChange" />
        <field id="channelActionsRequested" type="boolean" value="false" alwaysNotify="true" />
        <field id="chatIsVisible" type="bool" />
        <field id="chatOverlayMode" type="bool" value="false" onChange="onChatVisibilityChange" />
        <field id="streamLayoutMode" type="Integer" value="-1" />
        <field id="busySpinner" type="bool" />
        <field id="channelAvatar" type="string" alias="avatar.uri" />
        <field id="channelUsername" type="string" alias="channelUsername.text" />
        <field id="videoTitle" type="string" onChange="onVideoTitleChange" />
        <field id="viewersCount" type="integer" value="-1" onChange="onViewersCountChange" />
        <field id="QualityChangeRequestFlag" type="bool" value="false" alwaysNotify="true" />
        <field id="QualityChangeRequest" type="Integer" />
        <field id="streamDurationSeconds" type="Integer" value="0" />
        <field id="currentProgressBarState" type="Integer" value="1" />
        <field id="video_id" type="string" />
        <field id="video_type" type="string" onChange="onViewersCountChange" />
        <field id="qualityOptions" type="array" />
        <field id="selectedQuality" type="string" value="" />
        <!-- Set to roDateTime.AsSeconds() right before issuing an app-initiated
             seek=999999 to live edge. VideoPlayer's stall watchdog reads this
             and skips stall detection for ~20s after a seek, since the player
             freezes position briefly while re-buffering near the new live edge. -->
        <field id="recentSeekTimestamp" type="Integer" value="0" />
        <!-- When true, the one-shot startup live-edge seek is skipped for this
             StitchVideo session. Set by VideoPlayer before assigning content on
             recovery paths (watchdog reconnect, error-driven retryPlayback) so
             the player doesn't immediately re-anchor at the live edge after a
             stall — which would shrink buffer headroom and feed the next stall.
             VideoPlayer now always suppresses it: the seek measured further
             behind live than Roku's own start. -->
        <field id="suppressStartupSeek" type="bool" value="true" />
        <!-- True while this wrapper plays with lower live latency. -->
        <field id="lowLatency" type="bool" value="false" />

    </interface>

    <script type="text/brightscript" uri="StitchVideo.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/config.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/misc.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/analytics.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/twitchAdCountdown.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/twitchAdClock.brs" />
    <children>
        <AdCountdown id="adCountdown" />
        <!-- Live controls. Widths and x positions follow the video area
             (1280, or 960 beside chat) and are set in layoutOverlay(). -->
        <Group id="controlOverlay" translation="[0,458]">
            <MaskGroup id="scrimFade" maskuri="pkg:/images/vertical-mask.png" masksize="[1280,48]">
                <Rectangle id="scrimFadeFill" width="1280" height="48" color="0x0E0E10D9" />
            </MaskGroup>
            <Rectangle id="scrim" width="1280" height="214" translation="[0,48]" color="0x0E0E10D9" />
            <Label id="controlsHint" translation="[48,232]" width="1184" height="26" horizAlign="center" color="0xADADB8FF">
                <Font role="font" uri="pkg:/fonts/Archivo-Regular.otf" size="16" />
            </Label>

            <Group id="infoRow" translation="[48,32]">
                <CirclePoster id="avatar" width="48" height="48" translation="[0,0]" />
                <Group id="liveIndicator" translation="[64,3]">
                    <Poster id="liveBadge" uri="pkg:/images/twitch-redesign/round4.9.png" blendColor="0xEB0400FF" width="56" height="26" />
                    <Label id="liveLabel" color="0xFFFFFFFF" width="56" height="26" horizAlign="center" vertAlign="center">
                        <Font role="font" uri="pkg:/fonts/Archivo-Bold.otf" size="16" />
                    </Label>
                </Group>
                <SimpleLabel id="channelUsername" translation="[132,0]" text="" color="0xEFEFF1FF" fontSize="24" fontUri="pkg:/fonts/Archivo-Bold.otf" />
                <!-- EmojiLabel is positioned by the vertical center of its line
                     (vertAlign center), so y=48 keeps the 28 px line at 34-62. -->
                <EmojiLabel id="videoTitle" height="28" maxWidth="900" horizAlign="left" color="0xADADB8FF" translation="[64,48]">
                    <Font role="font" uri="pkg:/fonts/Archivo-Regular.otf" size="20" />
                </EmojiLabel>
                <Label id="viewerCount" visible="false" width="160" height="28" translation="[1024,34]" horizAlign="right" vertAlign="center" color="0xEFEFF1FF">
                    <Font role="font" uri="pkg:/fonts/Archivo-Regular.otf" size="18" />
                </Label>
                <Poster id="categoryArt" visible="false" width="84" height="112" loadWidth="168" loadHeight="224" loadDisplayMode="scaleToFit" translation="[64,64]" />
                <Label id="streamCategory" visible="false" width="868" height="24" translation="[64,80]" color="0xADADB8FF">
                    <Font role="font" uri="pkg:/fonts/Archivo-Regular.otf" size="18" />
                </Label>
                <Label id="liveUptime" visible="false" width="228" height="24" translation="[956,80]" horizAlign="right" color="0xEFEFF1FF">
                    <Font role="font" uri="pkg:/fonts/Archivo-Regular.otf" size="18" />
                </Label>
            </Group>
            <!-- Shown only while this session uses the low-latency experiment. -->
            <Label id="latencyTag" visible="false" width="360" height="26" translation="[872,35]" horizAlign="right" vertAlign="center" color="0xFFD37AFF">
                <Font role="font" uri="pkg:/fonts/Archivo-Regular.otf" size="18" />
            </Label>

            <!-- Focus caption: names the focused button above it. -->
            <Group id="caption" visible="false" translation="[0,140]">
                <Poster id="captionPlate" uri="pkg:/images/twitch-redesign/round6.9.png" blendColor="0x1F1F23FF" width="160" height="30" />
                <Label id="captionLabel" width="160" height="30" horizAlign="center" vertAlign="center" color="0xEFEFF1FF">
                    <Font role="font" uri="pkg:/fonts/Archivo-Bold.otf" size="18" />
                </Label>
            </Group>

            <!-- Back · Chat · Play/Pause · Quality, one contiguous group. -->
            <Group id="controls" translation="[494,178]">
                <Group id="backGroup" translation="[0,0]">
                    <Poster id="backBg" uri="pkg:/images/twitch-redesign/round6.9.png" blendColor="0x26262CFF" width="64" height="48" />
                    <Poster id="backFocus" uri="pkg:/images/twitch-redesign/focus-round6.9.png" width="64" height="48" visible="false" />
                    <Label width="64" height="48" horizAlign="center" vertAlign="center" text="←" color="0xFFFFFFFF">
                        <Font role="font" uri="pkg:/fonts/Archivo-Bold.otf" size="28" />
                    </Label>
                </Group>
                <Group id="chatGroup" translation="[76,0]">
                    <Poster id="chatBg" uri="pkg:/images/twitch-redesign/round6.9.png" blendColor="0x26262CFF" width="64" height="48" />
                    <Poster id="chatFocus" uri="pkg:/images/twitch-redesign/focus-round6.9.png" width="64" height="48" visible="false" />
                    <Poster id="messagesButton" uri="pkg:/images/messages.png" width="28" height="28" loadDisplayMode="scaleToFit" translation="[18,10]" />
                </Group>
                <Group id="playPauseGroup" translation="[152,0]">
                    <Poster id="playPauseBg" uri="pkg:/images/twitch-redesign/round6.9.png" blendColor="0x26262CFF" width="64" height="48" />
                    <Poster id="playPauseFocus" uri="pkg:/images/twitch-redesign/focus-round6.9.png" width="64" height="48" visible="false" />
                    <Poster id="controlButton" uri="pkg:/images/pause.png" width="28" height="28" loadDisplayMode="scaleToFit" translation="[18,10]" />
                </Group>
                <Group id="qualityGroup" translation="[228,0]">
                    <Poster id="qualityBg" uri="pkg:/images/twitch-redesign/round6.9.png" blendColor="0x26262CFF" width="64" height="48" />
                    <Poster id="qualityFocus" uri="pkg:/images/twitch-redesign/focus-round6.9.png" width="64" height="48" visible="false" />
                    <Poster id="qualitySelectButton" uri="pkg:/images/icons/sliders.png" width="28" height="28" loadDisplayMode="scaleToFit" translation="[18,10]" />
                </Group>
                <Group id="channelGroup" translation="[304,0]" visible="false">
                    <Poster uri="pkg:/images/twitch-redesign/round6.9.png" blendColor="0x26262CFF" width="64" height="48" />
                    <Poster id="channelFocus" uri="pkg:/images/twitch-redesign/focus-round6.9.png" width="64" height="48" visible="false" />
                    <Group translation="[18,10]">
                        <Poster uri="pkg:/images/profile-mask-540-white.png" width="6" height="6" loadWidth="6" loadHeight="6" loadDisplayMode="scaleToFit" translation="[0,11]" blendColor="0xFFFFFFFF" />
                        <Poster uri="pkg:/images/profile-mask-540-white.png" width="6" height="6" loadWidth="6" loadHeight="6" loadDisplayMode="scaleToFit" translation="[11,11]" blendColor="0xFFFFFFFF" />
                        <Poster uri="pkg:/images/profile-mask-540-white.png" width="6" height="6" loadWidth="6" loadHeight="6" loadDisplayMode="scaleToFit" translation="[22,11]" blendColor="0xFFFFFFFF" />
                    </Group>
                </Group>
            </Group>
        </Group>

        <!-- Loading Overlay -->
        <Group id="loadingOverlay" translation="[640,360]" visible="true">
            <LayoutGroup
                layoutDirection="vert"
                horizAlignment="center"
                vertAlignment="center"
                itemSpacings="[16]">
                <BusySpinner
                    id="loadingSpinner"
                    uri="pkg:/images/spinner.png"
                    spinInterval="1" />
                <SimpleLabel
                    id="loadingText"
                    text=""
                    color="0xEFEFF1FF"
                    fontSize="22"
                    fontUri="pkg:/fonts/Archivo-Regular.otf" />
            </LayoutGroup>
        </Group>
    </children>
</component>
