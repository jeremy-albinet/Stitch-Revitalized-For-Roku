<?xml version="1.0" encoding="utf-8"?>

<component name="VideoItem" extends="Group">

    <interface>
        <function name="onDestroy" />
        <field id="supportsDisposal" type="boolean" value="true" />
        <field id="itemContent" type="node" onChange="showcontent" />
        <field id="rowFocusPercent" type="float" onChange="showrowfocus" />
        <field id="itemHasFocus" type="boolean" onChange="onGetfocus" />
        <!-- Set by RowList. The card draws its own focus from these, because
             RowList focus bitmaps are drawn under opaque thumbnails. -->
        <field id="focusPercent" type="float" onChange="onFocusChange" />
        <field id="rowListHasFocus" type="boolean" onChange="onFocusChange" />
    </interface>

    <script type="text/brightscript" uri="VideoItem.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/contentBuilder.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/config.brs" />
    <children>
        <!-- Focus lift: a purple slab stays behind the thumbnail, offset down
             and left, with bevelled ends (Twitch's card hover, for remotes). -->
        <Group id="lift" visible="false">
            <Rectangle id="liftSlab" color="0x9147FFFF" width="320" height="180" />
            <Poster id="liftTop" uri="pkg:/images/twitch-redesign/lift-tl.png" blendColor="0x9147FFFF" />
            <Poster id="liftBottom" uri="pkg:/images/twitch-redesign/lift-br.png" blendColor="0x9147FFFF" />
        </Group>
        <!-- Shows while the thumbnail loads -->
        <Rectangle id="posterBase" color="0x1F1F23FF" width="320" height="180" />
        <Poster
            id="itemPoster"
            height="180"
            width="320"
            loadWidth="320"
            loadHeight="180"
            loadDisplayMode="scaleToFit">
            <!-- Native LIVE badge: red fill marks live only; text is localized -->
            <Group id="liveIcon" translation="[8,8]">
                <Poster id="liveBadge" uri="pkg:/images/twitch-redesign/round4.9.png" blendColor="0xEB0400FF" width="48" height="24" />
                <Label
                    id="liveLabel"
                    text="LIVE"
                    color="0xFFFFFFFF"
                    width="48"
                    height="24"
                    horizAlign="center"
                    vertAlign="center">
                    <Font role="font" uri="pkg:/fonts/Archivo-Bold.otf" size="16" />
                </Label>
            </Group>

        </Poster>
        <CirclePoster id="circlePoster" height="150" width="150" visible="false" />
        <!-- Focus ring for circular channel tiles -->
        <Poster
            id="circleRing"
            uri="pkg:/images/twitch-redesign/circle-ring.png"
            blendColor="0x9147FFFF"
            width="166"
            height="166"
            translation="[-6,-6]"
            visible="false" />
        <Rectangle
            id="itemMask"
            color="0x0e0e10ff"
            visible="false"
            opacity="0.75"
            width="512"
            height="288"
            scaleRotateCenter="[ 256.0, 144.0 ]" />
        <!-- Channel avatar beside the title on live cards; the corner overlay
             rounds it against the canvas without a MaskGroup. -->
        <Group id="avatarGroup" translation="[0,202]" visible="false">
            <Rectangle id="avatarBase" color="0x26262CFF" width="40" height="40" />
            <Poster id="avatar" width="40" height="40" loadWidth="80" loadHeight="80" loadDisplayMode="scaleToFill" />
            <Poster id="avatarCorners" uri="pkg:/images/twitch-redesign/avatar-corners.png" width="40" height="40" />
        </Group>
        <EmojiLabel
            id="itemLabel"
            height="28"
            maxWidth="320"
            color="0xEFEFF1FF"
            translation="[0, 208]">
            <Font role="font" uri="pkg:/fonts/Archivo-Bold.otf" size="20" />
        </EmojiLabel>
        <Label
            id="itemSubtitle"
            height="24"
            width="320"
            horizAlign="left"
            color="0xADADB8FF"
            translation="[0, 226]">
            <Font role="font" uri="pkg:/fonts/Archivo-Regular.otf" size="18" />
        </Label>
        <!-- Stat pills over the thumbnail: viewers / views bottom-left -->
        <Poster
            id="viewsRect"
            uri="pkg:/images/twitch-redesign/round4.9.png"
            blendColor="0x000000FF"
            opacity="0.7"
            height="24"
            translation="[8,148]">
        </Poster>
        <Label
            id="itemViewers"
            horizAlign="left"
            vertAlign="center"
            height="24"
            color="0xFFFFFFFF"
            translation="[16,148]">
            <Font role="font" uri="pkg:/fonts/Archivo-Bold.otf" size="16" />
        </Label>
        <Poster
            id="runtimeRect"
            uri="pkg:/images/twitch-redesign/round4.9.png"
            blendColor="0x000000FF"
            opacity="0.7"
            visible="false"
            height="24"
            translation="[8,8]">
        </Poster>
        <Label
            id="runtimeLabel"
            horizAlign="left"
            vertAlign="center"
            height="24"
            color="0xFFFFFFFF"
            visible="false"
            translation="[16,8]">
            <Font role="font" uri="pkg:/fonts/Archivo-Bold.otf" size="16" />
        </Label>
        <!-- Publish date pill top-left on videos and clips -->
        <Poster
            id="timestampRect"
            uri="pkg:/images/twitch-redesign/round4.9.png"
            blendColor="0x000000FF"
            opacity="0.7"
            height="24"
            translation="[8,8]">
        </Poster>
        <Label
            id="timestampLabel"
            horizAlign="left"
            vertAlign="center"
            height="24"
            color="0xFFFFFFFF"
            translation="[16,8]">
            <Font role="font" uri="pkg:/fonts/Archivo-Bold.otf" size="16" />
        </Label>

    </children>

</component>
