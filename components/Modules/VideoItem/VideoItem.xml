<?xml version="1.0" encoding="utf-8"?>

<component name="VideoItem" extends="Group">

    <interface>
        <field id="itemContent" type="node" onChange="showcontent" />
        <field id="rowFocusPercent" type="float" onChange="showrowfocus" />
        <field id="itemHasFocus" type="boolean" onChange="onGetfocus" />
    </interface>

    <script type="text/brightscript" uri="VideoItem.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/config.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/contentBuilder.brs" />
    <children>
        <Poster
            id="itemPoster"
            height="180"
            width="320"
            loadWidth="320"
            loadHeight="180"
            loadDisplayMode="scaleToFit">
            <Group id="liveIcon" translation="[8,8]">
                <Rectangle width="36" height="18" color="0xEB0400FF" />
                <Label
                    width="36"
                    height="18"
                    horizAlign="center"
                    vertAlign="center"
                    color="0xFFFFFFFF"
                    text="LIVE">
                    <Font role="font" uri="pkg:/fonts/Archivo-Bold.otf" size="12" />
                </Label>
            </Group>

        </Poster>
        <CirclePoster id="circlePoster" height="150" width="150" visible="false" />
        <Rectangle
            id="itemMask"
            color="0x0e0e10ff"
            visible="false"
            opacity="0.75"
            width="512"
            height="288"
            scaleRotateCenter="[ 256.0, 144.0 ]" />
        <EmojiLabel
            id="itemLabel"
            height="30"
            maxWidth="320"
            color="0xFFFFFFFF"
            translation="[0, 200]">
            <Font role="font" uri="pkg:/fonts/Archivo-Bold.otf" size="20" />
        </EmojiLabel>
        <Label
            id="itemSubtitle"
            height="30"
            width="320"
            horizAlign="left"
            color="0xFFFFFFFF"
            translation="[0, 210]">
            <Font role="font" uri="pkg:/fonts/Archivo-Regular.otf" size="16" />
        </Label>
        <Poster
            id="viewsRect"
            uri="pkg:/images/live_rectangle.9.png"
            translation="[5,157]">
        </Poster>
        <Label
            id="itemViewers"
            horizAlign="left"
            color="0xFFFFFFFF"
            translation="[7,157]">
            <Font role="font" uri="pkg:/fonts/Archivo-Regular.otf" size="14" />
        </Label>
        <Poster
            id="runtimeRect"
            uri="pkg:/images/live_rectangle.9.png"
            visible="false"
            translation="[5,23]">
        </Poster>
        <Label
            id="runtimeLabel"
            horizAlign="left"
            color="0xFFFFFFFF"
            translation="[7,23]">
            <Font role="font" uri="pkg:/fonts/Archivo-Regular.otf" size="14" />
        </Label>
        <Poster
            id="timestampRect"
            uri="pkg:/images/live_rectangle.9.png"
            translation="[5,23]">
        </Poster>
        <Label
            id="timestampLabel"
            horizAlign="left"
            color="0xFFFFFFFF"
            translation="[7,23]">
            <Font role="font" uri="pkg:/fonts/Archivo-Regular.otf" size="14" />
        </Label>

    </children>

</component>