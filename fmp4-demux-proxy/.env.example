# Copy to .env. Compose reads it automatically; uv needs --env-file .env.
PORT=8080
LOG_LEVEL=INFO

# Roku-reachable URL. Required behind a reverse proxy or nontrivial port/path mapping.
# Example: http://192.168.1.50:8080
# If empty, only the actual request scheme and Host are used; forwarded headers are ignored.
PROXY_PUBLIC_URL=

UPSTREAM_HOST_ALLOWLIST=ttvnw.net,twitch.tv,twitchcdn.net,cloudfront.net
UPSTREAM_CONNECT_TIMEOUT=5
UPSTREAM_READ_TIMEOUT=30
UPSTREAM_TOTAL_TIMEOUT=45
MAX_MANIFEST_BYTES=2097152
MAX_SEGMENT_BYTES=33554432
SEGMENT_CACHE_BYTES=134217728
MAX_UPSTREAM_CONCURRENCY=8
MAX_INFLIGHT_REQUESTS=64

# Keep false. True permits non-global/private addresses and an empty allowlist;
# use only for explicit development fixtures, never an exposed service.
ALLOW_UNSAFE_UPSTREAM=false
